# Copie ce fichier en ".env" :   cp env.example .env
# Adresse d'un noeud Radthal deja en ligne (nom:port). Exemple de forme : monnoeud.duckdns.org:9333
SEED_NODE=radthal-seed.duckdns.org:9333

# Nombre de coeurs utilises pour compiler. 1 ou 2 si la machine a peu de memoire.
BUILD_JOBS=2

# Alertes sur ton telephone (facultatif) : installe l'application "ntfy", abonne-toi a un sujet
# au nom difficile a deviner, puis mets son adresse ici. Exemple :
# NTFY_URL=https://ntfy.sh/radthal-3fa9c21b7d40
NTFY_URL=

# Alerte "plus de nouveau bloc" apres ce nombre de minutes (les blocs visent 10 minutes).
STALL_MINUTES=120

# Recherche des branches concurrentes, toutes les ... minutes (0 = jamais). Sur un noeud neuf, 10 est
# parfait. Si ton noeud a mine des milliers de blocs a difficulte 1, mets 0 : la liste serait enorme.
TIPS_CHECK_MINUTES=10
