# Copie ce fichier en ".env" :   cp env.example .env
# Adresse d'un noeud Radthal deja en ligne (nom:port). Par defaut : le noeud du createur, a laisser tel quel.
SEED_NODE=radthal-seed.duckdns.org:9333

# Nombre de coeurs utilises pour compiler. 1 ou 2 si la machine a peu de memoire.
BUILD_JOBS=2

# Alertes sur ton telephone (facultatif) : installe l'application "ntfy", abonne-toi a un sujet
# au nom difficile a deviner, puis mets son adresse ici. Exemple :
# NTFY_URL=https://ntfy.sh/radthal-3fa9c21b7d40
NTFY_URL=

# Alerte "plus de nouveau bloc" apres ce nombre de minutes (les blocs visent 10 minutes).
STALL_MINUTES=120

# Recherche des branches concurrentes, toutes les ... minutes (0 = jamais). Sur un noeud neuf, 10 est
# parfait. Si ton noeud a mine des milliers de blocs a difficulte 1, mets 0 : la liste serait enorme.
TIPS_CHECK_MINUTES=10

# Pages web (http://localhost:3777 = noeud, 3778 = tableau de bord, 3779 = mempool, 3781 = portefeuille, 3782 = horodatage).
# Par defaut elles ne sont visibles que depuis ce PC. Pour les voir depuis un autre appareil de ton reseau
# (telephone, autre PC), mets 0.0.0.0 : attention, la page portefeuille permet alors d'envoyer des RDT a quiconque
# est sur ton reseau tant que le portefeuille n'est pas protege par un mot de passe.
# UI_BIND=127.0.0.1

# Nom du portefeuille utilise par la page portefeuille (la page propose de le creer au premier lancement).
# WALLET_NAME=monportefeuille

# Pages a lancer (separees par des virgules). Ajoute ckpool seulement si tu mines.
# UI_VIEWS=node,dashboard,mempool,wallet,stamp

# La liste des pairs connectes cache leurs adresses (203.0.x.x, sans le port), pour qu'une capture d'ecran ne montre
# ni la tienne ni celle des autres. Mets 1 pour voir les adresses completes.
# SHOW_PEER_ADDR=0
