#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""Radthal : la fenetre de l'application (Ubuntu).

Une fenetre avec un menu a gauche (noeud, tableau de bord, mempool, portefeuille, horodatage) et la page choisie a droite,
sans barre d'adresse ni onglets. Le noeud lui-meme tourne en arriere-plan (service systemd "radthal", voir radthal-stack) :
fermer la fenetre ne l'arrete pas.

  radthal-app             ouvre la fenetre
  radthal-app --status    affiche l'etat du noeud dans le terminal (sans fenetre)
  radthal-app --version
"""
import json
import os
import re
import subprocess
import sys
import threading
import time
import urllib.request

VERSION = "@VERSION@"
APP_ID = "org.radthal.App"
RUN_DIR = os.environ.get("RADTHAL_RUN", "/run/radthal")
STACK = os.environ.get("RADTHAL_STACK", "/usr/lib/radthal/radthal-stack")
HOST = os.environ.get("RADTHAL_HOST", "127.0.0.1")
WEBSITE = "https://github.com/bryancarterdouglas/radthal"
PAGES = [                    # (cle, nom affiche, port) : les ports sont ceux de interface/launcher.py
    ("node", "Nœud", 3777),
    ("dashboard", "Tableau de bord", 3778),
    ("mempool", "Mempool", 3779),
    ("wallet", "Portefeuille", 3781),
    ("stamp", "Horodatage", 3782),
]
# Seules ces adresses s'ouvrent dans la fenetre : tout le reste part dans le navigateur.
ALLOWED = re.compile(r"^(https?://(127\.0\.0\.1|localhost):37(7[7-9]|8[0-2])(/|$)|about:blank$|blob:|data:)")


# ------------------------------------------------------------------ logique (sans interface graphique, testee a part)

def read_status():
    """(code, detail) ecrits par radthal-stack dans /run/radthal/status ; ("", "") si le fichier n'existe pas."""
    try:
        with open(os.path.join(RUN_DIR, "status"), encoding="utf-8") as f:
            lines = f.read().split("\n")
    except OSError:
        return "", ""
    return lines[0].strip(), (lines[1].strip() if len(lines) > 1 else "")


def service_state():
    try:
        r = subprocess.run(["systemctl", "is-active", "radthal.service"], capture_output=True, text=True, timeout=5)
        return r.stdout.strip()
    except Exception:
        return "unknown"


def fetch_json(port, path="/api/state", timeout=2):
    try:
        with urllib.request.urlopen("http://%s:%d%s" % (HOST, port, path), timeout=timeout) as r:
            return json.load(r) if r.status == 200 else None
    except Exception:
        return None


def summarize(state):
    """Une ligne pour le bas du menu, a partir de /api/state de la page noeud."""
    if not isinstance(state, dict):
        return ""
    items = {}
    for sec in state.get("sections") or []:
        for it in (sec.get("items") or []) if isinstance(sec, dict) else []:
            if isinstance(it, dict) and "id" in it:
                items[it["id"]] = it

    def num(k):
        v = (items.get(k) or {}).get("num")
        return v if isinstance(v, (int, float)) else None

    if not state.get("ok"):
        return "Le nœud ne répond pas encore"
    parts = ["Nœud en marche"]
    h, p = num("height"), num("peers")
    if h is not None:
        parts.append(("{:,}".format(int(h)).replace(",", " ")) + " blocs")
    if p is not None:
        parts.append("%d connexion%s" % (p, "s" if p > 1 else ""))
    return " · ".join(parts)


def describe(status, detail, svc, ready, waited):
    """Ce qu'on montre quand les pages ne sont pas (encore) joignables.
    status/detail : fichier d'etat ; svc : etat du service systemd ; ready : les pages repondent ;
    waited : secondes depuis que les conteneurs sont lances. Renvoie (code, titre, texte, action) ;
    action : None, "install", "start" ou "restart"."""
    if ready:
        return ("ready", "", "", None)
    if status == "docker-missing":
        return ("docker-missing", "Docker n'est pas installé",
                "Radthal fait tourner son nœud avec Docker. Un clic suffit pour l'installer : ton mot de passe sera demandé.", "install")
    if status == "compose-missing":
        return ("compose-missing", "Il manque un composant de Docker",
                "Il faut le module « Docker Compose ». Un clic suffit pour l'installer : ton mot de passe sera demandé.", "install")
    if status == "waiting-docker":
        return ("waiting", "En attente de Docker…", "Docker démarre, ça prend quelques secondes.", None)
    if status == "pulling":
        return ("working", "Téléchargement du nœud…",
                "La première fois, ça peut prendre quelques minutes. Tu peux laisser cette fenêtre ouverte.", None)
    if status == "building":
        return ("working", "Compilation du nœud…", (detail or "La première fois, ça peut durer de 10 minutes à plus d'une heure."), None)
    if status == "starting":
        return ("working", "Démarrage du nœud…", "", None)
    if status == "running":
        if waited > 180:
            return ("stuck", "Les pages ne répondent pas",
                    "Le nœud est lancé mais ses pages ne s'ouvrent pas. Regarde les détails, ou relance.", "restart")
        return ("working", "Démarrage des pages…", "", None)
    if status == "stopped":
        return ("stopped", "Le nœud est arrêté", "Il ne suit plus la chaîne. Tu peux le redémarrer.", "start")
    if status == "error":
        return ("error", "Un problème est survenu", detail or "Regarde les détails.", "restart")
    if svc == "failed":
        return ("error", "Le service Radthal a échoué", "Regarde les détails.", "restart")
    if svc == "activating":
        return ("working", "Démarrage…", "", None)
    if svc in ("inactive", "unknown", ""):
        return ("stopped", "Le nœud n'est pas démarré", "", "start")
    return ("working", "Démarrage des pages…", "", None)


def is_allowed(uri):
    return bool(ALLOWED.match(uri or ""))


def is_download(uri):
    """Les telechargements des pages (liste et certificats d'horodatage) sont des fichiers .json."""
    m = re.match(r"^http://(127\.0\.0\.1|localhost):37\d\d(/[^?#]*)", uri or "")
    return bool(m) and m.group(2).endswith(".json") and not m.group(2).startswith("/api/")


def unique_path(folder, name):
    name = re.sub(r"[^A-Za-z0-9._ -]", "_", os.path.basename(name or "")) or "fichier"
    base, ext = os.path.splitext(name)
    path, i = os.path.join(folder, name), 1
    while os.path.exists(path):
        path = os.path.join(folder, "%s (%d)%s" % (base, i, ext))
        i += 1
    return path


def log_tail(n=80):
    try:
        with open(os.path.join(RUN_DIR, "log"), encoding="utf-8", errors="replace") as f:
            return "".join(f.readlines()[-n:]) or "(journal vide)"
    except OSError:
        return "(pas encore de journal : le service n'a pas démarré)"


# ------------------------------------------------------------------ fenetre

CSS = b"""
window, .content { background: #0b1220; }
.side { background: #0e1626; border-right: 1px solid #1c2740; }
.side label { color: #cfd8ea; }
.side .brand { font-size: 20px; font-weight: bold; color: #ffffff; }
.side list { background: transparent; }
.side row { padding: 11px 20px; }
.side row:selected { background: #1b2740; border-left: 3px solid #ff7a2b; }
.side row:hover { background: #141f35; }
.side .muted { color: #8c9bb8; font-size: 12px; }
.side button { color: #cfd8ea; background: transparent; border: 1px solid #263553; box-shadow: none; text-shadow: none; }
.side button:hover { background: #1b2740; }
.splash .big { font-size: 24px; font-weight: bold; color: #ffffff; }
.splash .text { color: #b8c4dc; font-size: 15px; }
.splash button { padding: 8px 22px; }
.splash button.accent { background: #ff7a2b; color: #ffffff; border: none; box-shadow: none; text-shadow: none; }
"""


def run_gui():
    os.environ.setdefault("WEBKIT_DISABLE_DMABUF_RENDERER", "1")       # evite une fenetre blanche avec certains pilotes graphiques
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")                                   # sans ca, Ubuntu 24.04 charge Gdk 4 et Gtk 3 echoue
    try:
        gi.require_version("WebKit2", "4.1")
    except ValueError:
        gi.require_version("WebKit2", "4.0")
    from gi.repository import Gdk, Gio, GLib, Gtk, WebKit2

    GLib.set_prgname(APP_ID)
    GLib.set_application_name("Radthal")

    def open_external(uri):
        if uri.startswith(("http://", "https://")):
            try:
                Gio.AppInfo.launch_default_for_uri(uri, None)
            except Exception:
                pass

    class Win(Gtk.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Radthal")
            self.set_default_size(1280, 800)
            self.set_icon_name("radthal")
            try:
                self.set_wmclass(APP_ID, APP_ID)          # le bon nom de fenetre pour l'icone du dock (X11)
            except Exception:
                pass
            self.views = {}
            self.current = PAGES[0][0]
            self.ready = False
            self.busy = False
            self.running_since = None
            self.last_action = None

            root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
            self.add(root)

            # ---- menu de gauche
            side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            side.set_size_request(240, -1)
            side.get_style_context().add_class("side")
            head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            head.set_margin_top(22)
            head.set_margin_bottom(18)
            head.set_margin_start(20)
            head.set_margin_end(20)
            head.pack_start(Gtk.Image.new_from_icon_name("radthal", Gtk.IconSize.DND), False, False, 0)
            brand = Gtk.Label(label="Radthal", xalign=0)
            brand.get_style_context().add_class("brand")
            head.pack_start(brand, False, False, 0)
            side.pack_start(head, False, False, 0)

            self.listbox = Gtk.ListBox()
            self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
            for key, label, port in PAGES:
                row = Gtk.ListBoxRow()
                row.key, row.port = key, port
                row.add(Gtk.Label(label=label, xalign=0))
                self.listbox.add(row)
            self.listbox.connect("row-selected", self.on_row)
            side.pack_start(self.listbox, False, False, 0)

            side.pack_start(Gtk.Box(), True, True, 0)           # espace
            self.summary = Gtk.Label(label="", xalign=0)
            self.summary.set_line_wrap(True)
            self.summary.set_margin_start(20)
            self.summary.set_margin_end(14)
            self.summary.set_margin_bottom(10)
            self.summary.get_style_context().add_class("muted")
            side.pack_start(self.summary, False, False, 0)
            for text, handler in (("Copier mes sauvegardes", self.on_backup), ("Arrêter le nœud", self.on_stop),
                                  ("À propos", self.on_about)):
                b = Gtk.Button(label=text)
                b.set_margin_start(16)
                b.set_margin_end(16)
                b.set_margin_bottom(8)
                b.connect("clicked", handler)
                side.pack_start(b, False, False, 0)
            side.pack_start(Gtk.Box(), False, False, 6)
            root.pack_start(side, False, False, 0)

            # ---- contenu : l'ecran d'attente ou la page choisie
            self.stack = Gtk.Stack()
            self.stack.get_style_context().add_class("content")
            root.pack_start(self.stack, True, True, 0)
            self.stack.add_named(self.build_splash(), "splash")

            self.listbox.select_row(self.listbox.get_row_at_index(0))
            self.show_all()
            self.splash_action.hide()
            self.refresh()
            GLib.timeout_add(2000, self.refresh)

        # ---------------- ecran d'attente
        def build_splash(self):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
            box.get_style_context().add_class("splash")
            box.set_halign(Gtk.Align.CENTER)
            box.set_valign(Gtk.Align.CENTER)
            box.pack_start(Gtk.Image.new_from_icon_name("radthal", Gtk.IconSize.DIALOG), False, False, 0)
            self.splash_title = Gtk.Label(label="Radthal")
            self.splash_title.get_style_context().add_class("big")
            self.splash_text = Gtk.Label(label="")
            self.splash_text.get_style_context().add_class("text")
            self.splash_text.set_line_wrap(True)
            self.splash_text.set_max_width_chars(60)
            self.splash_text.set_justify(Gtk.Justification.CENTER)
            self.spinner = Gtk.Spinner()
            self.spinner.set_size_request(32, 32)
            self.splash_action = Gtk.Button(label="")
            self.splash_action.get_style_context().add_class("accent")
            self.splash_action.connect("clicked", self.on_action)
            details = Gtk.Button(label="Voir les détails")
            details.connect("clicked", self.on_details)
            for w in (self.splash_title, self.splash_text, self.spinner, self.splash_action, details):
                box.pack_start(w, False, False, 0)
            return box

        # ---------------- etat
        def refresh(self):
            if self.busy:
                return True
            self.busy = True
            threading.Thread(target=self.probe, daemon=True).start()
            return True

        def probe(self):
            status, detail = read_status()
            state = fetch_json(3777)
            svc = service_state() if state is None else "active"
            GLib.idle_add(self.apply, status, detail, svc, state)

        def apply(self, status, detail, svc, state):
            self.busy = False
            ready = state is not None
            if status == "running" and not ready:
                self.running_since = self.running_since or time.time()
            else:
                self.running_since = None
            waited = time.time() - self.running_since if self.running_since else 0
            code, title, text, action = describe(status, detail, svc, ready, waited)
            self.summary.set_text(summarize(state) if ready else "")
            if ready:
                if not self.ready:
                    self.ready = True
                    for v in self.views.values():          # le noeud revient : on recharge les pages deja ouvertes
                        v.reload()
                    self.show_page(self.current)
                return False
            self.ready = False
            self.splash_title.set_text(title)
            self.splash_text.set_text(text)
            if code in ("working", "waiting"):
                self.spinner.show()
                self.spinner.start()
            else:
                self.spinner.stop()
                self.spinner.hide()
            labels = {"install": "Installer Docker", "start": "Démarrer le nœud", "restart": "Relancer le nœud"}
            self.last_action = action
            if action:
                self.splash_action.set_label(labels[action])
                self.splash_action.show()
            else:
                self.splash_action.hide()
            self.stack.set_visible_child_name("splash")
            return False

        # ---------------- pages
        def view_for(self, key, port):
            v = self.views.get(key)
            if v is not None:
                return v
            v = WebKit2.WebView()
            s = v.get_settings()
            s.set_property("enable-developer-extras", False)
            s.set_property("enable-write-console-messages-to-stdout", False)
            v.connect("decide-policy", self.on_policy)
            v.connect("permission-request", self.on_permission)
            v.connect("create", self.on_create)
            v.load_uri("http://%s:%d/" % (HOST, port))
            self.stack.add_named(v, key)
            v.show()
            self.views[key] = v
            return v

        def show_page(self, key):
            port = dict((k, p) for k, _n, p in PAGES)[key]
            self.view_for(key, port)
            self.stack.set_visible_child_name(key)

        def on_row(self, listbox, row):
            if row is None:
                return
            self.current = row.key
            if self.ready:
                self.show_page(row.key)

        def on_policy(self, view, decision, dtype):
            if dtype in (WebKit2.PolicyDecisionType.NAVIGATION_ACTION, WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION):
                uri = decision.get_navigation_action().get_request().get_uri()
                if is_download(uri):
                    decision.download()
                    return True
                if not is_allowed(uri):
                    open_external(uri)
                    decision.ignore()
                    return True
                if dtype == WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION:
                    decision.ignore()
                    return True
            elif dtype == WebKit2.PolicyDecisionType.RESPONSE:
                if not decision.is_mime_type_supported():
                    decision.download()
                    return True
            return False

        def on_create(self, view, navigation_action):
            uri = navigation_action.get_request().get_uri()
            if not is_allowed(uri):
                open_external(uri)
            return None

        def on_permission(self, view, request):
            request.deny()
            return True

        # ---------------- telechargements (liste et certificats d'horodatage)
        def on_download(self, context, download):
            download.connect("decide-destination", self.on_destination)
            download.connect("failed", lambda d, err: self.info("Le téléchargement a échoué."))
            download.connect("finished", self.on_download_done)

        def on_destination(self, download, suggested):
            folder = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD) or os.path.expanduser("~")
            path = unique_path(folder, suggested)
            download.dest_path = path
            download.set_destination(GLib.filename_to_uri(path, None))
            return True

        def on_download_done(self, download):
            path = getattr(download, "dest_path", None)
            if path and os.path.exists(path):
                self.info("Fichier enregistré :\n%s" % path)

        # ---------------- actions
        def info(self, text):
            dlg = Gtk.MessageDialog(transient_for=self, modal=False, message_type=Gtk.MessageType.INFO,
                                    buttons=Gtk.ButtonsType.OK, text=text)
            dlg.connect("response", lambda d, r: d.destroy())
            dlg.show()

        def run_stack(self, action, done_text=None):
            def work():
                try:
                    r = subprocess.run(["pkexec", STACK, action], capture_output=True, text=True, timeout=3600)
                    rc, out = r.returncode, (r.stdout or "") + (r.stderr or "")
                except Exception as e:
                    rc, out = -1, str(e)
                GLib.idle_add(finished, rc, out)

            def finished(rc, out):
                if rc == 0:
                    if done_text:
                        self.info(done_text(out) if callable(done_text) else done_text)
                elif rc not in (126, 127):          # 126 = fenetre de mot de passe fermee
                    self.info("L'action a échoué.\n\n%s" % out[-600:])
                self.refresh()
                return False

            threading.Thread(target=work, daemon=True).start()

        def on_action(self, button):
            action = {"install": "install-docker", "start": "start", "restart": "restart"}.get(self.last_action)
            if action:
                self.run_stack(action)

        def on_stop(self, button):
            dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                    buttons=Gtk.ButtonsType.YES_NO, text="Arrêter le nœud ?")
            dlg.format_secondary_text("Il ne suivra plus la chaîne tant que tu ne l'as pas redémarré. "
                                      "Fermer la fenêtre, elle, ne l'arrête pas.")
            if dlg.run() == Gtk.ResponseType.YES:
                self.run_stack("stop")
            dlg.destroy()

        def on_backup(self, button):
            def text(out):
                if re.search(r"(^|\n)0 fichier", out):
                    return ("Aucune sauvegarde trouvée pour l'instant.\n\nCrée-en une dans la page Portefeuille "
                            "(bloc « Sauvegarde », bouton « Créer une sauvegarde maintenant »), puis reviens ici.")
                m = re.search(r"dans (.+)$", out.strip().splitlines()[-1] if out.strip() else "")
                if m:
                    try:
                        Gio.AppInfo.launch_default_for_uri(GLib.filename_to_uri(m.group(1), None), None)
                    except Exception:
                        pass
                return ("Tes sauvegardes sont copiées dans « Documents/Sauvegardes Radthal ».\n\n"
                        "Mets-les ensuite AUSSI sur une clé USB ou un autre appareil : si cet ordinateur tombe en panne, "
                        "c'est ta seule chance de retrouver tes RDT.\n\n" + out.strip())
            self.run_stack("export-backups", text)

        def on_details(self, button):
            dlg = Gtk.Dialog(title="Détails", transient_for=self, modal=False)
            dlg.set_default_size(760, 420)
            tv = Gtk.TextView()
            tv.set_editable(False)
            tv.set_monospace(True)
            tv.get_buffer().set_text("Service : %s\nÉtat : %s\n\n%s" % (service_state(), " / ".join(read_status()), log_tail()))
            sw = Gtk.ScrolledWindow()
            sw.add(tv)
            dlg.get_content_area().pack_start(sw, True, True, 0)
            dlg.add_button("Fermer", Gtk.ResponseType.CLOSE)
            dlg.connect("response", lambda d, r: d.destroy())
            dlg.show_all()

        def on_about(self, button):
            dlg = Gtk.AboutDialog(transient_for=self, modal=True)
            dlg.set_program_name("Radthal")
            dlg.set_version(VERSION)
            dlg.set_logo_icon_name("radthal")
            dlg.set_website(WEBSITE)
            dlg.set_comments("Ton nœud Radthal, sans ligne de commande.\nProjet expérimental, sans valeur garantie.")
            dlg.run()
            dlg.destroy()

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
            self.win = None

        def do_startup(self):
            Gtk.Application.do_startup(self)
            prov = Gtk.CssProvider()
            prov.load_from_data(CSS)
            Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        def do_activate(self):
            if self.win is None:
                self.win = Win(self)
                WebKit2.WebContext.get_default().connect("download-started", self.win.on_download)
            self.win.present()

    return App().run(sys.argv[:1])


def print_status():
    status, detail = read_status()
    state = fetch_json(3777)
    svc = service_state() if state is None else "active"
    code, title, text, action = describe(status, detail, svc, state is not None, 0)
    print("service : %s" % svc)
    print("état    : %s %s" % (status or "(aucun)", detail))
    print("pages   : %s" % ("répondent" if state is not None else "ne répondent pas"))
    print("résumé  : %s" % (summarize(state) or code))
    if title:
        print("%s %s" % (title, text))
    return 0


if __name__ == "__main__":
    if "--version" in sys.argv:
        print("Radthal " + VERSION)
        sys.exit(0)
    if "--status" in sys.argv:
        sys.exit(print_status())
    sys.exit(run_gui())
