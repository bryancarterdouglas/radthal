# Reglages de Radthal. Apres une modification : sudo systemctl restart radthal
# (les valeurs avec des espaces se mettent entre guillemets)

# Noeud Radthal deja en ligne a rejoindre : a laisser tel quel.
SEED_NODE=radthal-seed.duckdns.org:9333

# Version des images Docker. "latest" = la plus recente.
RADTHAL_TAG=appli-un-clic

# Les pages ne sont visibles que depuis cet ordinateur. 0.0.0.0 les ouvre a tout ton reseau
# (dangereux tant que le portefeuille n'est pas protege par un mot de passe).
# UI_BIND=127.0.0.1

# Nom du portefeuille utilise par la page Portefeuille.
# WALLET_NAME=monportefeuille

# Donner un nom a un pair dans la liste (adresse sans le port) :
# PEER_NAMES="192.168.1.20=Mon Pi,exemple.org=Chez Paul"
# Montrer les adresses completes dans la liste des pairs (a eviter si tu partages une capture) :
# SHOW_PEER_ADDR=0
