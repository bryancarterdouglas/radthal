+CAmount GetDevFeeAmount(int nHeight, const Consensus::Params& consensusParams)
+{
+    if (nHeight < consensusParams.devfee_start_height) return 0;
+    // 2 % de la subvention, arrondi a l'unite inferieure (la subvention est un multiple de 50 unites tant que le halving est < 6)
+    return GetBlockSubsidy(nHeight, consensusParams) * RADTHAL_DEVFEE_PERCENT / 100;
+}
+
+CScript GetDevFeeScript()
+{
+    using namespace util::hex_literals;
+    // rdt1qslzd9g3s34r7kc2pmhhvlv3uds37ddvvd5zuz6 : P2WPKH (version 0, programme de 20 octets)
+    return CScript() << OP_0 << "87c4d2a2308d47eb6141ddeecfb23c6c23e6b58c"_hex;
+}
